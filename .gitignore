# Godot genera esta carpeta al importar el proyecto.
.godot/
*.import
!assets/textures/stylized_terrain/*_seamless.png.import

# Builds locales y archivos del sistema.
builds/
dist/
.DS_Store
.idea/
__pycache__/
*.pyc
/web-game/
/web-game-live/

# Dependencias locales opcionales del servidor MCP.
tools/godot-mcp/
tools/runtime/
tools/export_templates/
.ci/

# De los packs fuente sólo versionamos los formatos útiles para Godot. Los
# proyectos de Blender/Unity duplican el mismo contenido.
