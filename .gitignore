# Godot genera esta carpeta al importar el proyecto.
.godot/
*.import
!assets/textures/stylized_terrain/*_seamless.png.import

# Builds locales y archivos del sistema.
builds/
dist/
.DS_Store
.idea/
__pycache__/
*.pyc
/web-game/
/web-game-live/
/generated/reviews/
/generated/caves/cave_surface.json

# Dependencias locales opcionales del servidor MCP.
tools/godot-mcp/
tools/runtime/
tools/export_templates/
.ci/

# De los packs fuente sólo versionamos los formatos útiles para Godot. Los
# proyectos de Blender/Unity duplican el mismo contenido.
assets/animations/Universal Animation Library 2\[Standard\]/Female Mannequin/
assets/animations/Universal Animation Library 2\[Standard\]/Unity/
assets/animations/Universal Animation Library 2\[Standard\]/*.png
assets/quaternius/Survival Pack - Sept 2020/Blends/
assets/quaternius/Modular Medieval Buildings - Jul 2017/Blends/
assets/quaternius/Modular Medieval Buildings - Jul 2017/FBX/

# Packs fuente que el usuario conserva localmente. El juego sólo versiona la
# selección mínima que usa en tiempo de ejecución para no subir cientos de MB.
